{
    auto_https off
}

:80 {
    encode zstd gzip

    handle /public/v1/* {
        reverse_proxy api:8000
    }

    handle /uploads/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy storefront:3100
    }
}

:81 {
    encode zstd gzip

    handle /api/v1/* {
        reverse_proxy api:8000
    }

    handle /uploads/* {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy admin:3000
    }
}
