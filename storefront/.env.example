# Server-side fetches (layout, home, detail pages)
PUBLIC_API_URL=http://localhost:8000/public/v1
# Client-side fetches (filters, map, forms) — baked into the JS bundle
NEXT_PUBLIC_API_URL=http://localhost:8000/public/v1
# Public origin — makes canonical URLs, hreflang, OG tags, robots.txt and
# sitemap.xml absolute. Inlined at build time (see Dockerfile).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
