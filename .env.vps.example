# Copy to .env.vps and replace every value before deployment.
# NOTE: this is a SEPARATE deployment from GRC (gr8trend.com). The real-estate
# site gets its own domains, its own database, and its own compose project —
# do not reuse GRC's grc database or its credentials here.
STORE_DOMAIN=kwt25.com
ADMIN_DOMAIN=cms.kwt25.com

POSTGRES_DB=kwt25
POSTGRES_USER=kwt25
# Use a long URL-safe value (letters, numbers, - and _) because it is embedded
# in DATABASE_URL by Docker Compose. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace_me

# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=replace_me

OWNER_EMAIL=owner@kwt25.com
OWNER_PASSWORD=replace_me

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
